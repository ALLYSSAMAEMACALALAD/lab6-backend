# Copy this file to .env for LOCAL development. Never commit .env.
# On Render, set these same names under Environment instead.

APP_ENV=development

# Aiven MySQL (Console > your service > Overview > Connection information)
DB_DRIVER=mysql
DB_HOST=your-service-name-your-project.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=
# Optional: path to the CA cert (default is app/certs/ca.pem)
# DB_SSL_CA=
# Optional: set true to also verify the server certificate
# DB_SSL_VERIFY=false

# JWT secrets - generate with:  php lava jwt:generate --show   (each 32+ random chars, must differ)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend URLs allowed to call this API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173
